# AnimeHub — local development configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored; nothing here should ever
# be committed. In CI these come from repository secrets, not from a file.

# AniList OAuth client. Register one at https://anilist.co/settings/developer
# The client ID is not secret, but keeping it out of the repo stops forks
# from silently sharing one (and hitting its rate limit).
ANIMEHUB_ANILIST_CLIENT_ID=
ANIMEHUB_ANILIST_CLIENT_SECRET=

# Must match the redirect URI registered for the client, character for
# character. Desktop loopback works out of the box; on Android register the
# custom scheme `animehub://anilist/callback` instead.
ANIMEHUB_ANILIST_REDIRECT_URI=http://127.0.0.1:17395/callback

# --- Android release signing (CI only) ---
# Never commit the keystore itself; supply it as a base64-encoded secret.
# ANDROID_KEYSTORE_BASE64=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
