# --- dependencies / build output ---
node_modules/
dist/
target/
src-tauri/target/
src-tauri/gen/schemas/
# Generated by `tauri android init`. Holds local.properties and, when
# signing, keystore.properties — never commit it.
src-tauri/gen/android/
src-tauri/gen/apple/

# --- secrets: never commit these ---
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
android-signing.properties
signing.properties
google-services.json

# --- local state that may hold session material ---
*.bin
*.wrapped

# --- editor / OS noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.log
__pycache__/
*.pyc

# --- local audit/report artifacts (not source) ---
graphify-out/
.pr30-audit/
.worktrees/
ARCHITECTURE_REPORT.md
SECURITY_BUG_AUDIT.md
PR30_FIX_REPORT.md
